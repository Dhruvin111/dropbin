{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Textbin API",
            "type": "shell",
            "command": "mvn spring-boot:run",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Stop Textbin API",
            "type": "shell",
            "command": "fuser -k 8080/tcp || pkill -f 'textbin-0.0.1-SNAPSHOT.jar' || true",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            }
        }
    ]
}
